<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="canonical" href="{{ canonical_url }}">
  <meta name="robots" content="index, follow">
  <title>{{ page_title }}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
  {% assign meta_desc = page_description | default: shop.description %}
  {% if meta_desc %}<meta name="description" content="{{ meta_desc | escape }}">{% endif %}
  {%- comment -%} Link-Vorschau (WhatsApp, Instagram, Facebook): Produktbild → Kollektionsbild → Share-Bild aus Theme-Einstellungen → Logo {%- endcomment -%}
  {%- assign og_type = 'website' -%}
  {%- assign og_img_w = '' -%}
  {%- assign og_img_h = '' -%}
  {%- assign og_img_alt = shop.name -%}
  {%- if template.name == 'product' and product.featured_image -%}
    {%- assign og_img = product.featured_image | image_url: width: 1200 -%}
    {%- assign og_img_alt = product.title -%}
    {%- assign og_type = 'product' -%}
  {%- elsif template.name == 'collection' and collection.image -%}
    {%- assign og_img = collection.image | image_url: width: 1200 -%}
    {%- assign og_img_alt = collection.title -%}
  {%- elsif settings.share_image != blank -%}
    {%- assign og_img = settings.share_image | image_url: width: 1200, height: 630, crop: 'center' -%}
    {%- assign og_img_w = '1200' -%}
    {%- assign og_img_h = '630' -%}
    {%- assign og_img_alt = settings.share_image.alt | default: shop.name -%}
  {%- else -%}
    {%- assign og_img = 'logo_nippon.png' | file_img_url: '1200x630' -%}
  {%- endif -%}
  {%- if og_img contains '//' -%}{%- assign og_img_start = og_img | slice: 0, 2 -%}{%- if og_img_start == '//' -%}{%- assign og_img = og_img | prepend: 'https:' -%}{%- endif -%}{%- endif -%}
  <link rel="icon" type="image/png" href="{{ 'logo_nippon.png' | file_img_url: '64x64' }}">
  <link rel="apple-touch-icon" href="{{ 'logo_nippon.png' | file_img_url: '180x180' }}">
  <meta property="og:type" content="{{ og_type }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  {% if meta_desc %}<meta property="og:description" content="{{ meta_desc | escape }}">{% endif %}
  <meta property="og:image" content="{{ og_img }}">
  <meta property="og:image:secure_url" content="{{ og_img }}">
  {%- if og_img_w != '' %}
  <meta property="og:image:width" content="{{ og_img_w }}">
  <meta property="og:image:height" content="{{ og_img_h }}">
  {%- endif %}
  <meta property="og:image:alt" content="{{ og_img_alt | escape }}">
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:locale" content="de_CH">
  {%- if template.name == 'product' %}
  <meta property="product:price:amount" content="{{ product.price | divided_by: 100.0 }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title | escape }}">
  {% if meta_desc %}<meta name="twitter:description" content="{{ meta_desc | escape }}">{% endif %}
  <meta name="twitter:image" content="{{ og_img }}">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ shop.name | escape }}",
    "url": "{{ shop.url }}",
    "logo": "{{ 'logo_nippon.png' | file_img_url: '200x200' }}",
    "description": "{{ shop.description | strip_html | escape }}",
    "sameAs": ["https://www.instagram.com/nipponnites/", "https://www.tiktok.com/@nippon_nites"],
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Im Grüntal 10",
      "addressLocality": "Winterthur",
      "postalCode": "8405",
      "addressRegion": "ZH",
      "addressCountry": "CH"
    }
  }
  </script>
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;700;900&family=Inter:wght@400;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
  <style>.material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }</style>
  {{ 'theme.min.css' | asset_url | stylesheet_tag }}
</head>
<body class="bg-night text-white font-sans antialiased">
  {% section 'ticker-bar' %}
  {% section 'announcement-bar' %}
  {% section 'header' %}
  <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>
  {% section 'footer' %}
  {% render 'cart-drawer' %}
  <ul hidden><li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li></ul>
  <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
  <button id="scroll-top-btn"
    aria-label="Nach oben"
    class="fixed bottom-8 right-6 z-40 md:hidden flex items-center justify-center w-12 h-12 opacity-0 pointer-events-none transition-opacity duration-300"
    style="background:linear-gradient(to bottom right,#ffb4a9,#fb5a48);"
    onclick="window.scrollTo({top:0,behavior:'smooth'})">
    <span class="material-symbols-outlined" style="color:#410000;font-size:22px;">arrow_upward</span>
  </button>
</body>
</html>
