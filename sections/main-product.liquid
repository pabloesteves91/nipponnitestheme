<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "{{ product.title | escape }}",
  "description": "{{ product.description | strip_html | strip_newlines | escape }}",
  "image": "https:{{ product.featured_image | image_url: width: 1200 }}",
  "brand": { "@type": "Brand", "name": "{{ shop.name | escape }}" },
  "offers": {
    "@type": "Offer",
    "price": "{{ product.price | divided_by: 100.0 }}",
    "priceCurrency": "{{ cart.currency.iso_code }}",
    "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
    "url": "{{ shop.url }}{{ product.url }}"
  }
}
</script>
{%- comment -%} Titel sauber aufteilen: 'A | B' oder letztes Wort farbig {%- endcomment -%}
{%- if product.title contains ' | ' -%}
  {%- assign _tparts = product.title | split: ' | ' -%}
  {%- assign _t1 = _tparts.first -%}
  {%- assign _t2 = _tparts.last -%}
{%- else -%}
  {%- assign _twords = product.title | split: ' ' -%}
  {%- if _twords.size > 1 -%}
    {%- assign _t2 = _twords.last -%}
    {%- assign _t1 = product.title | remove_last: _t2 | strip -%}
  {%- else -%}
    {%- assign _t1 = product.title -%}
    {%- assign _t2 = '' -%}
  {%- endif -%}
{%- endif -%}
{%- assign _factor = 1 -%}{%- if product.handle == 'custom-hoodie-t-shirt' or product.handle == 'custom-t-shirt' -%}{%- assign _factor = 0.8 -%}{%- endif -%}{%- if product.handle == 'wheelhead-niko-light' or product.handle == 'wheelhead-niko-premium' -%}{%- assign _factor = 0.85 -%}{%- endif -%}
{%- assign _is_apparel = false -%}
{%- for option in product.options_with_values -%}
  {%- assign _on = option.name | downcase -%}
  {%- if _on contains 'size' or _on contains 'grösse' or _on contains 'größe' -%}{%- assign _is_apparel = true -%}{%- endif -%}
{%- endfor -%}
<style>
  .nn-pdp{display:grid;grid-template-columns:1fr;}
  .nn-pdp__media{order:1;padding:16px;}
  .nn-pdp__buy{order:2;padding:24px 16px 32px;}
  .nn-pdp__desc{order:3;padding:0 16px 48px;}
  .nn-pdp__slider{aspect-ratio:4/5;}
  .nn-pdp__title{font-size:40px;}
  .nn-pdp__ship{display:flex;align-items:center;gap:8px;font-family:'Inter',sans-serif;font-size:13px;color:rgba(255,255,255,.65);margin-top:14px;}
  .nn-pdp__ship .material-symbols-outlined{font-size:18px;color:#ffb4a9;}
  .nn-pdp__sizetip{font-family:'Inter',sans-serif;font-size:12px;color:#ffb4a9;margin:-0.5rem 0 1.25rem;}
  .nn-sticky{position:fixed;left:0;right:0;bottom:0;z-index:45;background:#131313;border-top:1px solid rgba(255,255,255,.1);padding:10px 16px calc(10px + env(safe-area-inset-bottom));display:flex;align-items:center;gap:12px;transform:translateY(110%);transition:transform .3s;}
  .nn-sticky.is-visible{transform:translateY(0);}
  .nn-sticky__info{flex:1;min-width:0;}
  .nn-sticky__t{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:12px;text-transform:uppercase;letter-spacing:.06em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .nn-sticky__p{font-family:'Space Grotesk',sans-serif;font-size:14px;color:#ffb4a9;}
  .nn-sticky__btn{background:linear-gradient(to right,#ffb4a9,#fb5a48);color:#410000;font-family:'Space Grotesk',sans-serif;font-weight:800;text-transform:uppercase;letter-spacing:.08em;font-size:13px;padding:14px 18px;border:0;cursor:pointer;}
  #scroll-top-btn{bottom:88px !important;}
  @media (min-width:768px){
    .nn-pdp{grid-template-columns:7fr 5fr;}
    .nn-pdp__media{grid-column:1;grid-row:1;padding:48px;}
    .nn-pdp__desc{grid-column:1;grid-row:2;padding:0 48px 64px;}
    .nn-pdp__buy{grid-column:2;grid-row:1 / span 2;align-self:start;position:sticky;top:5rem;padding:64px;}
    .nn-pdp__slider{aspect-ratio:3/4;}
    .nn-pdp__title{font-size:64px;}
    .nn-sticky{display:none;}
  }
</style>
<div class="nn-pdp bg-surface">

  <!-- Bilder -->
  <div class="nn-pdp__media">
    <div id="pdp-slider" class="nn-pdp__slider relative overflow-hidden bg-surface-container-low select-none" style="width:100%;">
      <div id="pdp-slides" style="display:flex; width:100%; height:100%; transition:transform 0.4s cubic-bezier(0.25,0.46,0.45,0.94); will-change:transform;">
        {% for image in product.images %}
          <div style="flex:0 0 100%; width:100%; position:relative; overflow:hidden;">
            <img src="{{ image | image_url: width: 1000 }}"
                 alt="{{ image.alt | default: product.title | escape }}"
                 {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
                 style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block;">
          </div>
        {% endfor %}
      </div>
      {% if product.images.size > 1 %}
        <button onclick="pdpSlide(-1)" aria-label="Vorheriges Bild"
          style="position:absolute; left:0.75rem; top:50%; transform:translateY(-50%); background:rgba(19,19,19,0.75); border:1px solid rgba(255,255,255,0.15); color:#ffb4a9; width:2.5rem; height:2.5rem; display:flex; align-items:center; justify-content:center; cursor:pointer; z-index:10; padding:0;">
          <span class="material-symbols-outlined" style="font-size:20px;">chevron_left</span>
        </button>
        <button onclick="pdpSlide(1)" aria-label="Nächstes Bild"
          style="position:absolute; right:0.75rem; top:50%; transform:translateY(-50%); background:rgba(19,19,19,0.75); border:1px solid rgba(255,255,255,0.15); color:#ffb4a9; width:2.5rem; height:2.5rem; display:flex; align-items:center; justify-content:center; cursor:pointer; z-index:10; padding:0;">
          <span class="material-symbols-outlined" style="font-size:20px;">chevron_right</span>
        </button>
        <div style="position:absolute; bottom:1rem; left:50%; transform:translateX(-50%); display:flex; gap:0.4rem; z-index:10;">
          {% for image in product.images %}
            <button onclick="pdpGoTo({{ forloop.index0 }})" aria-label="Bild {{ forloop.index }}" class="pdp-dot"
              style="width:0.5rem; height:0.5rem; border-radius:9999px; border:none; cursor:pointer; padding:0; background:{% if forloop.first %}#ffb4a9{% else %}rgba(255,255,255,0.3){% endif %};"></button>
          {% endfor %}
        </div>
      {% endif %}
      {% if product.tags contains 'limited' %}
        <div style="position:absolute; top:1rem; left:1rem; z-index:10;">
          <span class="bg-surface-container-highest px-4 py-1 text-primary text-xs font-label tracking-[0.2em] uppercase flex items-center gap-2">
            <span class="w-2 h-2 bg-primary animate-pulse rounded-full"></span>
            Limited Edition
          </span>
        </div>
      {% endif %}
    </div>
    <script>
      (function() {
        var _cur = 0, _total = {{ product.images.size }}, _sx = 0;
        function _update() {
          var track = document.getElementById('pdp-slides');
          if (track) track.style.transform = 'translateX(-' + (_cur * 100) + '%)';
          document.querySelectorAll('.pdp-dot').forEach(function(d, i) { d.style.background = (i === _cur) ? '#ffb4a9' : 'rgba(255,255,255,0.3)'; });
        }
        window.pdpSlide = function(dir) { if (_total < 2) return; _cur = (_cur + dir + _total) % _total; _update(); };
        window.pdpGoTo = function(idx) { _cur = idx; _update(); };
        var sl = document.getElementById('pdp-slider');
        if (sl) {
          sl.addEventListener('touchstart', function(e) { _sx = e.touches[0].clientX; }, { passive: true });
          sl.addEventListener('touchend', function(e) { var dx = e.changedTouches[0].clientX - _sx; if (Math.abs(dx) > 40) pdpSlide(dx < 0 ? 1 : -1); }, { passive: true });
        }
      })();
    </script>
  </div>

  <!-- Kaufbereich -->
  <div class="nn-pdp__buy bg-surface-container-low h-fit">
    <div class="flex flex-col gap-6">
      <div class="space-y-2">
        {% if product.type != blank %}
          <p class="text-white/40 font-label text-sm tracking-[0.3em] uppercase">{{ product.type }}</p>
        {% endif %}
        <h1 class="nn-pdp__title font-headline font-black tracking-tighter uppercase leading-none">
          {{ _t1 }}{% if _t2 != blank %}<br><span class="text-primary">{{ _t2 }}</span>{% endif %}
        </h1>
        {%- if _factor != 1 -%}
          {%- assign discounted_price = product.price | times: _factor | round -%}
          <p id="product-price" class="text-2xl font-headline font-bold mt-4">
            <s style="color:rgba(255,255,255,0.35);font-size:0.875em;font-weight:400;">{{ product.price | money }}</s>
            <span style="margin-left:0.5rem;">{{ discounted_price | money }}</span>
          </p>
        {%- else -%}
          <p id="product-price" class="text-2xl font-headline font-bold mt-4">{{ product.price | money }}</p>
        {%- endif -%}
        {% render 'star-rating', product: product, show_button: true %}
      </div>

      {% if product.metafields.custom.short_description != blank %}
        <p class="text-white/70 font-body leading-relaxed max-w-md">{{ product.metafields.custom.short_description }}</p>
      {% endif %}

      {% form 'product', product, id: 'pdp-form' %}
        <div>
          {% for option in product.options_with_values %}
            {%- assign _oname = option.name | downcase -%}
            <div data-option-index="{{ forloop.index }}" style="margin-bottom:1.5rem;">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem;">
                <label style="font-family:'Space Grotesk',sans-serif; font-size:0.75rem; text-transform:uppercase; letter-spacing:0.15em; color:rgba(255,255,255,0.5);">{% if _oname == 'size' %}Grösse{% elsif _oname == 'color' %}Farbe{% else %}{{ option.name }}{% endif %}</label>
                {% if _is_apparel and forloop.last %}
                  <button type="button" onclick="document.getElementById('size-guide-modal').classList.remove('hidden')"
                    style="font-family:'Space Grotesk',sans-serif; font-size:0.7rem; text-transform:uppercase; letter-spacing:0.1em; color:#ffb4a9; text-decoration:underline; background:none; border:none; cursor:pointer; padding:0;">Grössentabelle</button>
                {% endif %}
              </div>
              <div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
                {% for value in option.values %}
                  <button type="button" data-option="{{ forloop.parentloop.index }}" data-value="{{ value | escape }}"
                    onclick="selectVariantOption({{ forloop.parentloop.index }}, '{{ value | escape }}', this)"
                    style="height:3rem; min-width:3rem; padding:0 1.1rem; border:1px solid {% if forloop.first %}#ffb4a9{% else %}rgba(255,255,255,0.15){% endif %}; color:{% if forloop.first %}#ffb4a9{% else %}rgba(255,255,255,0.7){% endif %}; background:{% if forloop.first %}rgba(255,180,169,0.1){% else %}transparent{% endif %}; font-family:'Space Grotesk',sans-serif; font-size:0.875rem; text-transform:uppercase; letter-spacing:0.1em; cursor:pointer; transition:all 0.15s ease;">{{ value }}</button>
                {% endfor %}
              </div>
            </div>
            {% if _is_apparel and forloop.last %}
              <p class="nn-pdp__sizetip">Tipp: Bestelle eine Nummer grösser.</p>
            {% endif %}
          {% endfor %}
          <input type="hidden" name="id" id="variant-id" value="{{ product.variants.first.id }}">
        </div>

        <script>
          var _variants = {{ product.variants | json }};
          var _selected = {};
          {% for option in product.options_with_values %}_selected[{{ forloop.index }}] = {{ option.values.first | json }};
          {% endfor %}
          function selectVariantOption(idx, value, el) {
            _selected[idx] = value;
            var group = el.closest('[data-option-index]');
            group.querySelectorAll('button[data-option]').forEach(function(b) { b.style.borderColor = 'rgba(255,255,255,0.15)'; b.style.color = 'rgba(255,255,255,0.7)'; b.style.background = 'transparent'; });
            el.style.borderColor = '#ffb4a9'; el.style.color = '#ffb4a9'; el.style.background = 'rgba(255,180,169,0.1)';
            var match = _variants.find(function(v) { return v.options.every(function(opt, i) { return _selected[i + 1] === opt; }); });
            if (!match) return;
            document.getElementById('variant-id').value = match.id;
            if (match.featured_image && typeof pdpGoTo === 'function') pdpGoTo(match.featured_image.position - 1);
            var fmt = window.__moneyFormat;
            if (!fmt) return;
            var _t1 = '{' + '{amount}}', _t2 = '{' + '{amount_with_comma_separator}}', _t3 = '{' + '{amount_no_decimals}}';
            function f(c) { var a = (c / 100).toFixed(2); return fmt.replace(_t1, a).replace(_t2, a.replace('.', ',')).replace(_t3, String(Math.floor(c / 100))); }
            var discFactor = {{ _factor | default: 1 }};
            var html = discFactor !== 1
              ? '<s style="color:rgba(255,255,255,0.35);font-size:0.875em;font-weight:400;">' + f(match.price) + '</s><span style="margin-left:0.5rem;">' + f(Math.round(match.price * discFactor)) + '</span>'
              : f(match.price);
            var priceEl = document.getElementById('product-price');
            if (priceEl) priceEl.innerHTML = html;
            var sp = document.getElementById('nn-sticky-price');
            if (sp) sp.innerHTML = discFactor !== 1 ? f(Math.round(match.price * discFactor)) : f(match.price);
            var btn = document.getElementById('pdp-add');
            if (btn) { btn.disabled = !match.available; btn.textContent = match.available ? 'In den Warenkorb' : 'Ausverkauft'; }
          }
        </script>

        <div class="space-y-4 pt-2">
          {% if product.available %}
            <button type="submit" name="add" id="pdp-add"
                    class="w-full bg-gradient-to-r from-primary to-primary-container h-16 text-on-primary-fixed font-headline font-extrabold uppercase tracking-widest hover:scale-[1.02] active:scale-95 transition-transform">In den Warenkorb</button>
          {% else %}
            <button disabled class="w-full bg-surface-container-highest h-16 text-white/30 font-headline font-extrabold uppercase tracking-widest cursor-not-allowed">Ausverkauft</button>
          {% endif %}
          {{ form | payment_button }}
        </div>
      {% endform %}

      <div>
        <p class="nn-pdp__ship"><span class="material-symbols-outlined">local_shipping</span>Wird für dich produziert · Lieferung in 10–20 Werktagen</p>
        <p class="nn-pdp__ship"><span class="material-symbols-outlined">undo</span>14 Tage Rückgaberecht</p>
        <p class="nn-pdp__ship"><span class="material-symbols-outlined">lock</span>Sichere Bezahlung mit TWINT, PayPal oder Karte</p>
      </div>

      <div class="flex items-center gap-3 flex-wrap">
        <svg width="38" height="24" viewBox="0 0 38 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="border:1px solid rgba(255,255,255,0.12); border-radius:3px;"><rect width="38" height="24" rx="3" fill="#1A1F71"/><text x="19" y="16" font-family="Arial,sans-serif" font-size="11" font-weight="bold" fill="white" text-anchor="middle" letter-spacing="1">VISA</text></svg>
        <svg width="38" height="24" viewBox="0 0 38 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="border:1px solid rgba(255,255,255,0.12); border-radius:3px;"><rect width="38" height="24" rx="3" fill="#252525"/><circle cx="15" cy="12" r="7" fill="#EB001B"/><circle cx="23" cy="12" r="7" fill="#F79E1B"/><path d="M19 6.8a7 7 0 0 1 0 10.4A7 7 0 0 1 19 6.8z" fill="#FF5F00"/></svg>
        <svg width="38" height="24" viewBox="0 0 38 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="border:1px solid rgba(255,255,255,0.12); border-radius:3px;"><rect width="38" height="24" rx="3" fill="white"/><text x="19" y="16" font-family="Arial,sans-serif" font-size="8" font-weight="900" fill="#000" text-anchor="middle" letter-spacing="0.5">TWINT</text></svg>
        <svg width="38" height="24" viewBox="0 0 38 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="border:1px solid rgba(255,255,255,0.12); border-radius:3px;"><rect width="38" height="24" rx="3" fill="#000"/><path d="M13.5 8.2c.5-.6.8-1.4.7-2.2-.7 0-1.5.5-2 1.1-.4.5-.8 1.3-.7 2.1.8.1 1.5-.4 2-1z" fill="white"/><path d="M16.2 9.2c-1.1-.1-2.1.6-2.6.6s-1.3-.6-2.2-.6C10 9.3 8.6 10.1 8 11.4c-1.2 2.1-.3 5.2.9 6.9.6.8 1.3 1.7 2.2 1.7.9 0 1.2-.6 2.2-.6 1.1 0 1.3.6 2.2.6.9 0 1.6-.9 2.2-1.7.4-.5.5-1 .7-1-.7-.3-2.4-1.4-2.4-3.4 0-1.8 1.3-2.7 1.4-2.8-.7-1.1-1.9-1.9-3.2-1.9z" fill="white"/></svg>
        <svg width="38" height="24" viewBox="0 0 38 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="border:1px solid rgba(255,255,255,0.12); border-radius:3px;"><rect width="38" height="24" rx="3" fill="#002C8A"/><text x="19" y="16" font-family="Arial,sans-serif" font-size="8" font-weight="bold" fill="white" text-anchor="middle">PayPal</text></svg>
      </div>

      <div class="border-t border-white/10 pt-6 space-y-4">
        <details class="group cursor-pointer">
          <summary class="flex justify-between items-center py-2 list-none">
            <h4 class="font-label uppercase tracking-widest text-sm">Versand & Rückgabe</h4>
            <span class="text-primary text-xl group-open:rotate-45 transition-transform">+</span>
          </summary>
          <div class="text-xs text-white/50 leading-relaxed font-body mt-3 space-y-2">
            <p>Jedes Teil wird nach deiner Bestellung für dich produziert. Die Lieferung dauert 10–20 Werktage, mit Sendungsverfolgung (sofern verfügbar). Die Versandkosten siehst du im Checkout.</p>
            <p>Rückgabe innert 14 Tagen für ungetragene, ungewaschene Artikel. Die Kosten für den Rückversand trägst du. Personalisierte Artikel sind von der Rückgabe ausgeschlossen. <a href="/policies/refund-policy" class="text-primary underline">Details</a></p>
          </div>
        </details>
        {% if _is_apparel %}
        <details class="group cursor-pointer">
          <summary class="flex justify-between items-center py-2 list-none">
            <h4 class="font-label uppercase tracking-widest text-sm">Material & Pflege</h4>
            <span class="text-primary text-xl group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="text-xs text-white/50 leading-relaxed font-body mt-3">Kalt und auf links waschen. Nicht in den Trockner. Bei niedriger Temperatur bügeln (Druck und Stickerei aussparen).</p>
        </details>
        {% endif %}
      </div>
    </div>
  </div>

  <!-- Produktdetails -->
  {% if product.description != blank %}
    <div class="nn-pdp__desc">
      <h2 class="font-headline text-2xl font-bold uppercase tracking-tight mb-6">Produktdetails</h2>
      <div class="text-white/60 font-body text-sm leading-relaxed max-w-xl">{{ product.description }}</div>
    </div>
  {% endif %}
</div>

{% if product.available %}
<div class="nn-sticky" id="nn-sticky" aria-hidden="true">
  <div class="nn-sticky__info">
    <div class="nn-sticky__t">{{ product.title }}</div>
    <div class="nn-sticky__p" id="nn-sticky-price">{% if _factor != 1 %}{{ product.price | times: _factor | round | money }}{% else %}{{ product.price | money }}{% endif %}</div>
  </div>
  <button type="button" class="nn-sticky__btn" onclick="var b=document.getElementById('pdp-add'); if(b){ if(b.disabled){ b.scrollIntoView({behavior:'smooth',block:'center'}); } else { b.click(); } }">In den Warenkorb</button>
</div>
<script>
  (function(){
    var bar = document.getElementById('nn-sticky'), btn = document.getElementById('pdp-add');
    if (!bar || !btn || !('IntersectionObserver' in window)) return;
    new IntersectionObserver(function(entries){
      var e = entries[0];
      var below = e.boundingClientRect.top < 0;
      bar.classList.toggle('is-visible', !e.isIntersecting && below);
    }).observe(btn);
  })();
</script>
{% endif %}

<!-- Grössentabelle -->
<div id="size-guide-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-black/80 backdrop-blur-sm" onclick="document.getElementById('size-guide-modal').classList.add('hidden')"></div>
  <div class="relative bg-surface-container-low border border-outline-variant w-full max-w-lg p-8 z-10">
    <div class="flex justify-between items-center mb-8">
      <h3 class="font-headline font-black text-2xl uppercase tracking-tighter">Grössentabelle</h3>
      <button onclick="document.getElementById('size-guide-modal').classList.add('hidden')" class="text-white/40 hover:text-white text-2xl leading-none" aria-label="Schliessen">×</button>
    </div>
    <p class="text-white/40 text-xs font-body mb-6 uppercase tracking-widest">Alle Masse in Zentimetern (cm)</p>
    <table class="w-full text-sm font-body">
      <thead>
        <tr class="border-b border-white/10">
          <th class="text-left py-3 font-headline text-xs uppercase tracking-widest text-white/40">Grösse</th>
          <th class="text-center py-3 font-headline text-xs uppercase tracking-widest text-white/40">Brust</th>
          <th class="text-center py-3 font-headline text-xs uppercase tracking-widest text-white/40">Länge</th>
          <th class="text-center py-3 font-headline text-xs uppercase tracking-widest text-white/40">Schulter</th>
          <th class="text-center py-3 font-headline text-xs uppercase tracking-widest text-white/40">Ärmel</th>
        </tr>
      </thead>
      <tbody>
        <tr class="border-b border-white/5"><td class="py-3 font-headline font-bold text-primary">XS</td><td class="py-3 text-center text-white/70">86</td><td class="py-3 text-center text-white/70">64</td><td class="py-3 text-center text-white/70">41</td><td class="py-3 text-center text-white/70">62</td></tr>
        <tr class="border-b border-white/5"><td class="py-3 font-headline font-bold text-primary">S</td><td class="py-3 text-center text-white/70">92</td><td class="py-3 text-center text-white/70">66</td><td class="py-3 text-center text-white/70">43</td><td class="py-3 text-center text-white/70">64</td></tr>
