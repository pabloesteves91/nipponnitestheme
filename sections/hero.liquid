<section class="relative min-h-[100dvh] w-full overflow-hidden flex items-end">

  <!-- Background image -->
  <div class="absolute inset-0 z-0">
    {% if section.settings.bg_image != blank %}
      <img src="{{ section.settings.bg_image | img_url: '1920x' }}"
           alt="{{ section.settings.bg_image_alt | escape }}"
           class="w-full h-full object-cover grayscale brightness-[0.45]">
    {% else %}
      <div class="w-full h-full bg-[#1b1b1b]"></div>
    {% endif %}

    <!-- Gradient overlays for legibility -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#131313] via-[#131313]/50 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#131313]/80 via-[#131313]/20 to-transparent"></div>
  </div>

  <!-- Main content -->
  <div class="relative z-10 w-full max-w-screen-xl mx-auto px-8 pb-16 md:pb-24 flex flex-col md:flex-row md:items-end md:justify-between gap-12">

    <!-- Left: Main hero content -->
    <div class="flex-1">
      {% if section.settings.badge != blank %}
        <span class="inline-block bg-primary text-on-primary-fixed px-3 py-1 text-[10px] font-headline font-black tracking-[0.25em] uppercase mb-5 sr">
          {{ section.settings.badge }}
        </span>
      {% endif %}

      <!-- Thin accent line -->
      <div class="h-px bg-primary/30 w-full max-w-xs mb-6 sr sr-delay-1"></div>

      <h1 class="font-headline text-[13vw] md:text-[10vw] lg:text-[9vw] uppercase font-black tracking-[-0.02em] leading-[0.9] mb-10 sr sr-delay-1">
        {{ section.settings.headline_line1 }}<br>
        <span class="text-transparent" style="-webkit-text-stroke: 2px #ffb4a9;">
          {{ section.settings.headline_outline }}
        </span>
        <br>
        {{ section.settings.headline_line2 }}
      </h1>

      <div class="flex flex-col sm:flex-row gap-4 sr sr-delay-2">
        {% if section.settings.cta_primary_label != blank %}
          <a href="{{ section.settings.cta_primary_url }}"
             class="bg-gradient-to-r from-primary to-primary-container text-on-primary-fixed font-headline font-black uppercase py-5 px-10 tracking-widest text-sm hover:brightness-110 active:scale-95 transition-all inline-block text-center">
            {{ section.settings.cta_primary_label }}
          </a>
        {% endif %}
        {% if section.settings.cta_secondary_label != blank %}
          <a href="{{ section.settings.cta_secondary_url }}"
             class="border border-white/20 text-white font-headline font-bold uppercase py-5 px-10 tracking-widest text-sm hover:border-primary hover:text-primary transition-all inline-block text-center">
            {{ section.settings.cta_secondary_label }}
          </a>
        {% endif %}
      </div>
    </div>

    <!-- Right: Editorial brand panel (desktop only) -->
    <div class="hidden md:flex flex-col items-end gap-6 shrink-0 pb-2">
      <div class="flex items-center gap-3 opacity-30">
        <span class="h-px w-8 bg-white"></span>
        <span class="font-headline text-[10px] uppercase tracking-[0.3em]">{{ section.settings.brand_label | default: 'Tokyo Underground' }}</span>
      </div>
      <p class="font-headline text-[10px] uppercase tracking-[0.25em] text-white/20 text-right max-w-[120px] leading-relaxed">
        Hand-illustriert<br>Bio-Baumwolle<br>Winterthur CH
      </p>
      <span class="font-headline font-black text-[10px] tracking-[0.3em] text-primary/60 uppercase">&#x2191; SCROLL</span>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Hero – Night Runner",
  "settings": [
    { "type": "image_picker", "id": "bg_image",           "label": "Background image" },
    { "type": "text",         "id": "bg_image_alt",       "label": "Image alt text",        "default": "Tokyo night street" },
    { "type": "text",         "id": "badge",              "label": "Badge text",             "default": "Limited Drop 001" },
    { "type": "text",         "id": "brand_label",        "label": "Brand label (rechts)",   "default": "Tokyo Underground" },
    { "type": "text",         "id": "headline_line1",     "label": "Headline Zeile 1",       "default": "BESTELLE DEINEN" },
    { "type": "text",         "id": "headline_outline",   "label": "Outline Wort",           "default": "EIGENEN" },
    { "type": "text",         "id": "headline_line2",     "label": "Headline Zeile 2",       "default": "HOODIE" },
    { "type": "text",         "id": "cta_primary_label",  "label": "Primär-Button",          "default": "Dein Hoodie" },
    { "type": "url",          "id": "cta_primary_url",    "label": "Primär-Button URL" },
    { "type": "text",         "id": "cta_secondary_label","label": "Sekundär-Button",        "default": "Lookbook" },
    { "type": "url",          "id": "cta_secondary_url",  "label": "Sekundär-Button URL" }
  ],
  "presets": [{ "name": "Hero – Night Runner" }]
}
{% endschema %}
