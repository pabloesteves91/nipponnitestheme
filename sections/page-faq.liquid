<!-- FAQ Hero -->
<section class="bg-surface pt-32 pb-16 px-8">
  <div class="max-w-4xl mx-auto text-center">
    <span class="font-label text-primary uppercase tracking-[0.4em] text-sm mb-4 block">Support</span>
    <h1 class="font-headline text-6xl md:text-8xl font-black uppercase tracking-tighter leading-none mb-6">FAQ</h1>
    <p class="text-white/40 font-body text-lg max-w-xl mx-auto">Häufig gestellte Fragen. Brauchst du weitere Hilfe?
      <a href="mailto:info@nipponnites.com" class="text-primary hover:brightness-110 transition-all">info@nipponnites.com</a>
    </p>
  </div>
</section>

<!-- FAQ Accordion (Inhalte als Blöcke im Theme Editor) -->
<style>
  .nn-faq-a{color:rgba(255,255,255,.5);font-family:'Inter',sans-serif;font-size:1rem;line-height:1.625;padding-bottom:1.25rem;}
  .nn-faq-a p{margin:0 0 .75rem;}
  .nn-faq-a p:last-child{margin-bottom:0;}
  .nn-faq-a a{color:#ffb4a9;}
</style>
<section class="bg-surface pb-32 px-8">
  <div class="max-w-3xl mx-auto divide-y divide-white/10">
    {%- assign _open = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'group' -%}
        {%- if _open -%}</div></div>{%- endif -%}
        <div class="py-6" {{ block.shopify_attributes }}>
          <h2 class="font-headline font-bold text-sm uppercase tracking-[0.3em] text-primary mb-6">{{ block.settings.title }}</h2>
          <div class="space-y-0 divide-y divide-white/5">
        {%- assign _open = true -%}
      {%- else -%}
        {%- unless _open -%}<div class="py-6"><div class="space-y-0 divide-y divide-white/5">{%- assign _open = true -%}{%- endunless -%}
        <details class="group cursor-pointer" {{ block.shopify_attributes }}>
          <summary class="flex justify-between items-center py-5 list-none">
            <h3 class="font-headline font-bold uppercase tracking-tight text-lg">{{ block.settings.question }}</h3>
            <span class="text-primary text-2xl group-open:rotate-45 transition-transform duration-200 shrink-0 ml-4" aria-hidden="true">+</span>
          </summary>
          <div class="nn-faq-a">{{ block.settings.answer }}</div>
        </details>
      {%- endif -%}
    {%- endfor -%}
    {%- if _open -%}</div></div>{%- endif -%}
  </div>
</section>

{%- comment -%} FAQ als strukturierte Daten – wird automatisch aus denselben Blöcken erzeugt {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- assign _first = true -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'question' and block.settings.question != blank -%}
        {%- unless _first -%},{%- endunless -%}{%- assign _first = false %}
    {
      "@type": "Question",
      "name": {{ block.settings.question | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | replace: '</p>', ' </p>' | strip_html | strip_newlines | split: ' ' | join: ' ' | json }} }
    }
      {%- endif -%}
    {%- endfor %}
  ]
}
</script>

<!-- CTA -->
<section class="bg-surface-container-low border-t border-white/5 py-20 px-8 text-center">
  <p class="text-white/40 font-body mb-4">Deine Frage ist nicht dabei?</p>
  <a href="mailto:info@nipponnites.com" class="inline-block bg-gradient-to-r from-primary to-primary-container text-on-primary-fixed font-headline font-bold uppercase py-4 px-12 tracking-widest hover:brightness-110 active:scale-95 transition-all">
    Schreib uns
  </a>
</section>

{% schema %}
{
  "name": "FAQ Page",
  "settings": [],
  "blocks": [
    { "type": "group", "name": "Gruppe", "settings": [
      { "type": "text", "id": "title", "label": "Gruppentitel", "default": "Allgemein" }
    ] },
    { "type": "question", "name": "Frage", "settings": [
      { "type": "text", "id": "question", "label": "Frage", "default": "Frage" },
      { "type": "richtext", "id": "answer", "label": "Antwort", "default": "<p>Antwort</p>" }
    ] }
  ],
  "presets": [{ "name": "FAQ Page" }]
}
{% endschema %}
