<section class="w-full py-32 md:py-40 relative bg-surface-container-low overflow-hidden">

  <!-- Background texture: single large bleed text, right-anchored -->
  <div class="absolute inset-y-0 right-0 flex items-center pointer-events-none select-none overflow-hidden">
    <span class="font-headline font-black uppercase leading-none whitespace-nowrap text-white/[0.04]"
          style="font-size: 28vw; transform: translateX(10%);">
      {{ section.settings.bg_text }}
    </span>
  </div>

  <!-- Left-anchored content -->
  <div class="relative z-10 max-w-screen-xl mx-auto px-8">

    <div class="sr">
      <h2 class="font-headline uppercase font-black tracking-tighter leading-[0.88] italic"
          style="font-size: clamp(4rem, 10vw, 9rem);">
        {{ section.settings.headline_line1 }}<br>
        <span class="text-primary">{{ section.settings.headline_line2 }}</span>
      </h2>
    </div>

    <div class="mt-10 flex items-center gap-6 sr sr-delay-1">
      <span class="h-px w-12 bg-primary/50 shrink-0"></span>
      <p class="font-headline text-[11px] tracking-[0.35em] uppercase text-white/40">
        {{ section.settings.subline }}
      </p>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Passion Banner",
  "settings": [
    { "type": "text", "id": "bg_text",        "label": "Hintergrund-Text",   "default": "PASSION" },
    { "type": "text", "id": "headline_line1", "label": "Headline Zeile 1",   "default": "PASSION IS NOT" },
    { "type": "text", "id": "headline_line2", "label": "Headline Zeile 2",   "default": "A CRIME." },
    { "type": "text", "id": "subline",        "label": "Subline",            "default": "Street Heritage // 2024" }
  ],
  "presets": [{ "name": "Passion Banner" }]
}
{% endschema %}
