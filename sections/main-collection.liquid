{% paginate collection.products by 50 %}

{% comment %} Build unique product types for filter tabs {% endcomment %}
{% assign product_types_raw = '' %}
{% for product in collection.products %}
  {% if product.type != blank %}
    {% assign pt_lower = product.type | downcase %}
    {% unless product_types_raw contains pt_lower %}
      {% assign product_types_raw = product_types_raw | append: product.type | append: '|||' %}
    {% endunless %}
  {% endif %}
{% endfor %}
{% assign type_array = product_types_raw | split: '|||' %}

<!-- Collection Hero -->
<section class="px-8 pt-20 pb-16 md:pt-24 md:pb-20 bg-[#1b1b1b]">
  <div class="max-w-screen-xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-[1fr_auto] items-end gap-8">
      <div>
        <span class="font-headline text-[10px] tracking-[0.3em] uppercase text-primary/70 mb-4 block sr">
          Collection
        </span>
        <h1 class="font-headline font-black uppercase tracking-tighter leading-none sr sr-delay-1"
            style="font-size: clamp(3.5rem, 11vw, 8rem);">
          {{ collection.title }}
        </h1>
      </div>
      {% if collection.description != blank %}
        <div class="md:max-w-[220px] md:pb-2 sr sr-delay-2">
          <p class="text-white/40 font-body text-sm leading-relaxed">{{ collection.description }}</p>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<!-- Filters + Sort bar -->
<div class="border-t border-white/5 bg-surface sticky top-[80px] z-30">
  <div class="max-w-screen-xl mx-auto px-8 py-4 flex flex-col sm:flex-row gap-4 sm:items-center sm:justify-between">

    <!-- Horizontal filter text links -->
    <div class="flex items-center gap-6 overflow-x-auto pb-1 scrollbar-hide">
      <button
        onclick="filterProducts('all', this)"
        data-filter="all"
        class="filter-tab font-headline text-xs uppercase tracking-[0.2em] text-primary border-b border-primary pb-px whitespace-nowrap shrink-0 transition-all"
      >
        Alle ({{ collection.products_count }})
      </button>
      {% for type in type_array %}
        {% if type != blank %}
          {% assign type_count = 0 %}
          {% for p in collection.products %}
            {% if p.type == type %}{% assign type_count = type_count | plus: 1 %}{% endif %}
          {% endfor %}
          <button
            onclick="filterProducts('{{ type | downcase | escape }}', this)"
            data-filter="{{ type | downcase | escape }}"
            class="filter-tab font-headline text-xs uppercase tracking-[0.2em] text-white/40 hover:text-primary border-b border-transparent hover:border-primary pb-px whitespace-nowrap shrink-0 transition-all"
          >
            {{ type }} ({{ type_count }})
          </button>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Sort + Count -->
    <div class="flex items-center gap-6 shrink-0">
      <span id="product-count" class="font-headline text-[10px] tracking-[0.2em] uppercase text-white/20">{{ collection.products_count }} Produkte</span>
      <select
        onchange="window.location = '{{ collection.url }}?sort_by=' + this.value"
        class="bg-transparent border-b border-white/10 text-xs font-headline uppercase tracking-widest text-white/40 focus:ring-0 cursor-pointer py-1 pr-4 hover:text-primary hover:border-primary transition-all"
      >
        <option value="manual" {% if collection.sort_by == 'manual' %}selected{% endif %}>Featured</option>
        <option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>Neueste</option>
        <option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>Preis aufsteigend</option>
        <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>Preis absteigend</option>
        <option value="best-selling" {% if collection.sort_by == 'best-selling' %}selected{% endif %}>Bestseller</option>
      </select>
    </div>

  </div>
</div>

<!-- Product Grid -->
<section class="max-w-screen-xl mx-auto px-8 py-16">

  {% if collection.products.size > 0 %}
    <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-16">
      {% for product in collection.products %}
        <div class="group relative product-card sr" data-type="{{ product.type | downcase | escape }}" style="transition-delay: {{ forloop.index0 | modulo: 3 | times: 80 }}ms">

          <!-- Image container -->
          <div class="aspect-[4/5] overflow-hidden bg-[#1b1b1b] relative">
            <a href="{{ product.url }}" class="block w-full h-full">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | img_url: '600x800', crop: 'center' }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                >
              {% else %}
                <div class="w-full h-full flex items-center justify-center text-white/10 font-headline text-xs uppercase tracking-widest">Kein Bild</div>
              {% endif %}
            </a>

            <!-- Hover overlay -->
            <div class="absolute inset-0 bg-[#131313]/80 flex flex-col justify-end p-5 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              {% if product.type != blank %}
                <span class="text-primary text-[9px] tracking-[0.25em] font-headline font-black uppercase block mb-1">{{ product.type }}</span>
              {% endif %}
              <h3 class="font-headline text-xl uppercase font-black leading-tight mb-1">{{ product.title }}</h3>
              <span class="font-headline font-bold text-primary/80 text-sm mb-4">{% if product.price_varies %}ab {% endif %}{{ product.price_min | money }}</span>
              <a href="{{ product.url }}" class="inline-block bg-primary text-on-primary-fixed font-headline font-black uppercase text-[10px] tracking-widest py-3 px-5 hover:brightness-110 transition-all self-start">
                {% if product.available %}Ansehen &rarr;{% else %}Ausverkauft{% endif %}
              </a>
            </div>

            <!-- Badges -->
            {% if product.available == false %}
              <div class="absolute top-3 left-3">
                <span class="bg-[#353535] text-white/50 px-2 py-1 text-[9px] font-headline font-black uppercase tracking-widest">Sold Out</span>
              </div>
            {% elsif product.compare_at_price > product.price %}
              <div class="absolute top-3 left-3">
                <span class="bg-primary text-[#410000] px-2 py-1 text-[9px] font-headline font-black uppercase tracking-widest">Sale</span>
              </div>
            {% endif %}
          </div>

          <!-- Static info below image -->
          <div class="pt-4 flex justify-between items-start gap-4">
            <h3 class="font-headline font-bold text-sm uppercase leading-tight tracking-tight text-white/70 group-hover:text-primary transition-colors">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h3>
            <span class="font-headline text-sm font-bold text-white/40 shrink-0">{% if product.price_varies %}ab {% endif %}{{ product.price_min | money }}</span>
          </div>

        </div>
      {% endfor %}
    </div>

  {% else %}
    <div class="text-center py-32">
      <p class="font-headline text-4xl font-black uppercase tracking-tighter text-white/10 mb-8">Keine Produkte.</p>
      <a href="/collections/all" class="inline-block px-12 py-4 bg-gradient-to-r from-primary to-[#fb5a48] text-[#410000] font-headline font-black uppercase tracking-widest text-sm hover:brightness-110 transition-all">
        Alle ansehen
      </a>
    </div>
  {% endif %}
</section>

<!-- Marquee Banner -->
<section class="py-12 bg-[#0e0e0e] overflow-hidden border-t border-white/5">
  <div class="whitespace-nowrap flex">
    <span class="font-headline font-black text-[8vw] text-[#2a2a2a] uppercase leading-none px-8 animate-[marquee_20s_linear_infinite]">
      PASSION IS NOT A CRIME &bull;&nbsp;
    </span>
    <span class="font-headline font-black text-[8vw] text-[#2a2a2a] uppercase leading-none px-8 animate-[marquee_20s_linear_infinite]">
      PASSION IS NOT A CRIME &bull;&nbsp;
    </span>
  </div>
</section>

{% endpaginate %}

<script>
function filterProducts(type, btn) {
  document.querySelectorAll('.filter-tab').forEach(function(b) {
    b.classList.remove('text-primary', 'border-primary');
    b.classList.add('text-white/40', 'border-transparent');
  });
  btn.classList.remove('text-white/40', 'border-transparent');
  btn.classList.add('text-primary', 'border-primary');

  var cards = document.querySelectorAll('.product-card');
  var visible = 0;
  cards.forEach(function(card) {
    if (type === 'all' || card.dataset.type === type) {
      card.style.display = '';
      visible++;
    } else {
      card.style.display = 'none';
    }
  });

  var countEl = document.getElementById('product-count');
  if (countEl) countEl.textContent = visible + ' Produkte';
}
</script>

{% schema %}
{
  "name": "Collection Page",
  "settings": [],
  "presets": [{ "name": "Collection Page" }]
}
{% endschema %}
