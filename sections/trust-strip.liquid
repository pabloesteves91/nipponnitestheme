<style>
  .nn-trust{background:#1b1b1b;border-top:1px solid rgba(255,255,255,.06);border-bottom:1px solid rgba(255,255,255,.06);padding:20px 16px;}
  .nn-trust__grid{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:18px 12px;}
  .nn-trust__item{display:flex;align-items:center;gap:10px;font-family:'Space Grotesk',sans-serif;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.85);line-height:1.3;}
  .nn-trust__item .material-symbols-outlined{color:#ffb4a9;font-size:22px;flex-shrink:0;}
  @media (min-width:768px){.nn-trust{padding:24px 32px;}.nn-trust__grid{grid-template-columns:repeat(4,1fr);}.nn-trust__item{justify-content:center;font-size:13px;}}
</style>
<section class="nn-trust">
  <div class="nn-trust__grid">
    {%- for block in section.blocks -%}
      <div class="nn-trust__item" {{ block.shopify_attributes }}>
        <span class="material-symbols-outlined">{{ block.settings.icon }}</span>
        <span>{{ block.settings.text }}</span>
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Vertrauens-Leiste",
  "max_blocks": 4,
  "blocks": [
    { "type": "item", "name": "Punkt", "settings": [
      { "type": "text", "id": "icon", "label": "Material Icon Name", "default": "check" },
      { "type": "text", "id": "text", "label": "Text", "default": "Vorteil" }
    ] }
  ],
  "presets": [{ "name": "Vertrauens-Leiste" }]
}
{% endschema %}
